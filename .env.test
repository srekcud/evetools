# Test environment (loaded after .env when APP_ENV=test).
# Real environment variables always win over this file: inside the `app`
# container, the values injected by docker-compose.yaml are used instead.
# Secrets are never stored here; put local overrides in .env.test.local (ignored).

APP_SECRET=test-secret-not-used-in-production
DEFAULT_URI=http://localhost

# Credentials come from .env (POSTGRES_*). doctrine.yaml appends the `_test`
# suffix to the database name in the test env: the database used is `eve_app_test`.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"

MESSENGER_TRANSPORT_DSN=in-memory://
REDIS_URL=redis://redis:6379
# Scheduler lock (SyncScheduler): local store, tests run on a single host.
LOCK_DSN=flock

ESI_BASE_URL=https://esi.evetech.net/latest
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# No admin in tests unless a test sets it explicitly.
ADMIN_CHARACTER_IDS=
