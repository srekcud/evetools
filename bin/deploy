#!/usr/bin/env bash
set -euo pipefail

prod=()

classify_services() {
    awk -v app_image="$1" -v proxy_image="$2" '
        /^[^ #]/ { in_services = ($0 == "services:"); next }
        in_services && /^  [A-Za-z0-9_.-]+:[ ]*$/ { service = $1; sub(/:$/, "", service); next }
        in_services && service != "" && /^    image:/ {
            image = $2
            gsub(/["\047]/, "", image)
            role = "infra"
            if (index(image, app_image) == 1) { role = "app" }
            else if (index(image, proxy_image) == 1) { role = "proxy" }
            print role, service
            service = ""
        }
    '
}

container_id_of() {
    "${prod[@]}" ps -aq "$1"
}

main() {
    local version="${1:-${SSH_ORIGINAL_COMMAND:-}}"
    if [[ ! "$version" =~ ^V[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
        echo "usage: bin/deploy V<major>.<minor>[.<patch>] (got '${version}')" >&2
        exit 64
    fi

    cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.."
    local deploy_dir="$PWD"
    local backup_dir="${BACKUP_DIR:-$HOME/backups/evetools}"
    local backups_kept="${BACKUPS_KEPT:-10}"
    local image_repository="ghcr.io/srekcud"

    exec 9> "$deploy_dir/.deploy.lock"
    flock --nonblock 9 || { echo "another deploy is running" >&2; exit 75; }

    local previous_version
    previous_version="$(cat .deployed-version 2>/dev/null || echo none)"
    echo "==> deploying ${version} (currently ${previous_version})"

    git fetch --quiet --force --tags origin
    git checkout --quiet --detach "refs/tags/${version}"

    docker pull "${image_repository}/evetools-app:${version}"
    docker pull "${image_repository}/evetools-proxy:${version}"

    prod=(docker compose -f docker-compose.yaml -f docker-compose.prod.yml)
    export APP_VERSION="$version"

    local app_services=() infra_services=() role service
    while read -r role service; do
        case "$role" in
            app) app_services+=("$service") ;;
            infra) infra_services+=("$service") ;;
        esac
    done < <("${prod[@]}" config | classify_services "${image_repository}/evetools-app:" "${image_repository}/evetools-proxy:")
    if (( ${#app_services[@]} == 0 )); then
        echo "!! no compose service uses ${image_repository}/evetools-app: nothing was touched" >&2
        exit 1
    fi

    mkdir -p "$backup_dir"
    local backup_file
    backup_file="${backup_dir}/evetools-$(date -u +%Y%m%dT%H%M%SZ)-before-${version}.dump"
    echo "==> backing up the database to ${backup_file}"
    "${prod[@]}" exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom' > "$backup_file"
    ls -1t "$backup_dir"/evetools-*.dump | tail -n +"$((backups_kept + 1))" | xargs -r rm --

    local existing_app_services=()
    for service in "${app_services[@]}"; do
        if [[ -n "$(container_id_of "$service")" ]]; then
            existing_app_services+=("$service")
        fi
    done
    if (( ${#existing_app_services[@]} > 0 )); then
        echo "==> stopping ${existing_app_services[*]} (the proxy serves the maintenance page)"
        "${prod[@]}" stop "${existing_app_services[@]}"
    fi

    if (( ${#infra_services[@]} > 0 )); then
        echo "==> bringing ${infra_services[*]} to their compose definition"
        local -A infra_container_before=()
        for service in "${infra_services[@]}"; do
            infra_container_before[$service]="$(container_id_of "$service")"
        done
        "${prod[@]}" up -d --no-build --pull never --wait "${infra_services[@]}"
        for service in "${infra_services[@]}"; do
            local infra_container_after infra_state="unchanged"
            infra_container_after="$(container_id_of "$service")"
            if [[ -z "${infra_container_before[$service]}" ]]; then
                infra_state="created"
            elif [[ "${infra_container_before[$service]}" != "$infra_container_after" ]]; then
                infra_state="recreated"
            fi
            echo "==> infra ${service}: ${infra_state}"
        done
    fi

    echo "==> running migrations"
    if ! "${prod[@]}" run --rm --no-deps --entrypoint php app \
        bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration; then
        echo "!! migrations failed: restarting ${previous_version} containers" >&2
        echo "!! a migration may be partially applied; backup: ${backup_file}" >&2
        if [[ "$previous_version" != none ]]; then
            git checkout --quiet --detach "refs/tags/${previous_version}"
        fi
        if (( ${#existing_app_services[@]} > 0 )); then
            "${prod[@]}" start "${existing_app_services[@]}"
        fi
        exit 1
    fi

    echo "==> starting ${version}"
    "${prod[@]}" up -d --no-build --pull never --force-recreate --remove-orphans --wait --wait-timeout 180 "${app_services[@]}"
    "${prod[@]}" up -d --no-build --pull never --force-recreate --wait proxy

    echo "$version" > .deployed-version
    docker image prune --force > /dev/null
    echo "==> ${version} deployed (previous: ${previous_version}, backup: ${backup_file})"
}

main "$@"
exit
