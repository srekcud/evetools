{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src/Industry/Domain", "src/Industry/Application"]
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit",
    "initialTestsPhpOptions": "-d pcov.enabled=1",
    "tmpDir": "var/infection/core/tmp",
    "logs": {
        "text": "var/infection/core/infection.log",
        "html": "var/infection/core/infection.html",
        "summary": "var/infection/core/summary.log"
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 98,
    "minCoveredMsi": 98
}
